cum_df <-
stats %>%
select(-down) %>%
right_join(all_dates) %>%
arrange(date) %>%
filter(date <= Sys.Date()) %>%
pivot_longer(
cols = -date,
names_to = c("metric")
) %>%
mutate(
.by = metric,
cum = cumsum(replace(value, is.na(value), 0)),
scale_factor = max(cum) / max(value, na.rm = T),
cum_scaled = cum / scale_factor
)
cum_df %>%
filter(metric == "km") %>%
ggplot(aes(date)) +
facet_wrap(~metric, labeller = labeller(metric = c(km = "Kilomètre"))) +
# Daily bars
geom_col(
aes(y = value),
fill = "steelblue",
alpha = 0.6,
) +
# Cumulative line (already scaled per metric)
geom_line(
aes(y = cum_scaled),
color = "darkred",
linewidth = 1
) +
# Points only when activity exists
geom_point(
aes(y = if_else(value != 0, cum_scaled, NA)),
color = "darkred",
size = 2
) +
scale_y_continuous(
name = "Daily km",
labels = scales::label_number(suffix = " km"),
breaks = seq(0,20,2),
sec.axis = sec_axis(
name = "Cumulative km",
labels = scales::label_number(suffix = " km"),
breaks = seq(0,100,10),
~ . * scale_factor,
)
) +
theme_bw() +
theme(
strip.text = element_text(face = "bold")
)
